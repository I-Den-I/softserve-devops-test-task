services:
  postgres-server:
    image: postgres:15-alpine
    environment:
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_secret_password
      - POSTGRES_DB=zabbix
    restart: always

  zabbix-server:
    image: zabbix/zabbix-server-pgsql:alpine-7.0-latest
    environment:
      - DB_SERVER_HOST=postgres-server
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_secret_password
      - POSTGRES_DB=zabbix
    ports:
      - "10051:10051"
    depends_on:
      - postgres-server
    restart: always

  zabbix-web:
    image: zabbix/zabbix-web-nginx-pgsql:alpine-7.0-latest
    environment:
      - DB_SERVER_HOST=postgres-server
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_secret_password
      - POSTGRES_DB=zabbix
      - ZBX_SERVER_HOST=zabbix-server
      - PHP_TZ=Europe/Kyiv
    ports:
      - "8085:8080"
    depends_on:
      - postgres-server
      - zabbix-server
    restart: always